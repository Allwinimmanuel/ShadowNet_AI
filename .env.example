# ShadowNet AI — Environment Configuration Example
# Copy this file to .env and configure values as appropriate for your environment.

# JWT & Security Secrets (Must be at least 32 characters in production)
JWT_SECRET_KEY=shadownet-super-secure-production-jwt-secret-key-min-32-chars-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Configurations
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Target Application (SecureBank Integration)
SHADOWNET_API_URL=http://localhost:8000/api
SECUREBANK_API_URL=http://localhost:8001/api

# Database URL (SQLite default for local demonstration)
DATABASE_URL=sqlite:///./shadownet.db

# Model Configuration
MODEL_PATH=models/login_attack_model.joblib
METADATA_PATH=models/model_metadata.json

# Hardened Security Policies
MAX_FAILED_ATTEMPTS_LOCKOUT=5
MAX_IP_BURST_PER_MINUTE=10
STRICT_SECURITY_MODE=false
